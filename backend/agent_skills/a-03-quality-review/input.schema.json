{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["file_id", "content_hash", "candidate_id", "fields_sha256"],
  "properties": {
    "file_id": {"type": "string", "format": "uuid"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string"},
    "fields_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retrieval_run_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}}
  },
  "additionalProperties": false
}
