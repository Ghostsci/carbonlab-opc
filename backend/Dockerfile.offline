FROM node:22-alpine AS frontend-builder

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./

ARG VITE_DEMO_EMAIL=demo@huasheng-steel.com
ARG VITE_DEMO_PASSWORD
ENV VITE_DEMO_EMAIL=${VITE_DEMO_EMAIL}
ENV VITE_DEMO_PASSWORD=${VITE_DEMO_PASSWORD}
RUN npm run build


FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    CARBONLAB_STATIC_DIR=/app/frontend-dist \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY backend/requirements.offline.txt /tmp/requirements.offline.txt
RUN pip install --no-cache-dir -r /tmp/requirements.offline.txt \
    && find /usr/local/lib/python3.12/site-packages -type d \
       \( -name tests -o -name test -o -name __pycache__ \) -prune -exec rm -rf '{}' + \
    && find /usr/local/lib/python3.12/site-packages -type f \
       \( -name '*.pyc' -o -name '*.pyo' \) -delete \
    && rm /tmp/requirements.offline.txt

COPY backend/ ./backend/
COPY scripts/ ./scripts/
COPY --from=frontend-builder /frontend/dist/ ./frontend-dist/

RUN find /app -type d \( -name tests -o -name __pycache__ \) -prune -exec rm -rf '{}' +

EXPOSE 8000

CMD ["uvicorn", "backend.offline_entry:app", "--host", "0.0.0.0", "--port", "8000"]
