# Application
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURITY_HSTS_ENABLED=false

# Database (Docker Compose example; replace for your own environment)
DATABASE_URL=postgresql+psycopg2://carbonlab_user:change_me@db:5432/carbonlab_opc

# Authentication — generate a long random value before shared or production use
JWT_SECRET=replace_with_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false

# OpenAI-compatible model provider. Leave the key empty for offline/static tests.
LLM_API_BASE=https://api.example.invalid/v1
LLM_API_KEY=
LLM_MODEL=replace_with_approved_model
EMBEDDING_MODEL=replace_with_approved_embedding_model

# Local storage is the default migration mode.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/app/uploads
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=carbonlab-opc
MINIO_SECURE=false

# Optional async runtime; not required by the migrated P0 UI flow.
REDIS_URL=redis://redis:6379/0

# Frontend development proxy
VITE_API_PROXY_TARGET=http://localhost:8000
