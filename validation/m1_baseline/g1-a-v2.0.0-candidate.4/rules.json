  "unit_dictionary": {
    "rule_id": "G1A2-UNIT-001",
    "dictionary_id": "G1A2-UNIT-DICT-1",
    "unit_code_matching": "exact_case_sensitive",
    "alias_guessing": false,
    "binary_float": "forbidden",
    "intermediate_rounding": "forbidden",
    "units": {
      "t": {"dimension": {"PRODUCT_MASS": 1}, "base_numerator": 1000, "base_denominator": 1},
      "kWh": {"dimension": {"ENERGY": 1}, "base_numerator": 3600000, "base_denominator": 1},
      "kgCO2e": {"dimension": {"EMISSION_CO2E": 1}, "base_numerator": 1, "base_denominator": 1},
      "tCO2e": {"dimension": {"EMISSION_CO2E": 1}, "base_numerator": 1000, "base_denominator": 1}
    },
    "compound_units": {
      "kgCO2e/kWh": [{"unit_code": "kgCO2e", "exponent": 1}, {"unit_code": "kWh", "exponent": -1}],
      "tCO2e/t": [{"unit_code": "tCO2e", "exponent": 1}, {"unit_code": "t", "exponent": -1}]
    },
    "formal_field_units": {"production_output": "t", "purchased_electricity": "kWh"},
    "result_units": {"indirect_emissions": "tCO2e", "emission_intensity": "tCO2e/t"}
  },
  "calculation": {
    "rule_id": "G1A2-CALC-001",
    "formula_type": "ACTIVITY_DATA_MULTIPLIED_BY_EMISSION_FACTOR",
    "formula_steps": [
      "E_kgCO2e = purchased_electricity_kWh * factor_kgCO2e_per_kWh",
      "E_tCO2e_raw = E_kgCO2e / 1000",
      "E_tCO2e = quantize(E_tCO2e_raw, 0.000001, ROUND_HALF_UP)",
      "I_raw = E_tCO2e_raw / production_output_t",
      "I_tCO2e_per_t = quantize(I_raw, 0.000001, ROUND_HALF_UP)"
    ],
    "working_decimal_precision_minimum": 50,
    "intermediate_rounding": false,
    "final_quantum": "0.000001",
    "final_rounding_mode": "ROUND_HALF_UP",
    "negative_zero_normalization": "0.000000",
    "calculation_requires_confirmed_fields": 9,
    "failure_result_created": false
  },
